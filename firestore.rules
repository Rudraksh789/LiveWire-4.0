rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: You must deploy these rules manually!
    // Either run `firebase deploy --only firestore:rules` in your terminal,
    // or paste this entire file's contents into the Firebase Console 
    // under Firestore Database > Rules, then click "Publish".
    
    match /registrations/{registrationId} {
      // Allow public creation if the document contains required nested fields
      allow create: if request.resource.data.keys().hasAll(['school', 'teacher', 'events'])
        && request.resource.data.school.keys().hasAll(['name', 'email'])
        && request.resource.data.teacher.keys().hasAll(['name', 'phone', 'email']);
      
      // Allow authenticated admins to read, update, and delete
      allow read, update, delete: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
